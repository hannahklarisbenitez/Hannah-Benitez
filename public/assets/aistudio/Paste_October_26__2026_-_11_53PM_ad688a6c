<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuickPrint Hub - Printing Shop Queue & Order Management System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        // User-specified 4-color palette:
                        theme: {
                            light: '#F5F5F5',
                            teal: '#76ABAE',
                            charcoal: '#303841',
                            orange: '#FF5722',
                        },
                        primary: {
                            DEFAULT: '#FF5722',
                            dark: '#E64A19',
                            light: '#FBE9E7',
                        },
                        secondary: {
                            DEFAULT: '#76ABAE',
                            dark: '#5A8D90',
                            light: '#EAF3F3',
                        },
                        dark: {
                            DEFAULT: '#303841',
                            surface: '#242B33',
                            light: '#3A4750',
                        },
                        light: {
                            DEFAULT: '#F5F5F5',
                            paper: '#FFFFFF',
                        },
                        // Remap utility color classes to the 4-color palette
                        blue: {
                            50: '#FBE9E7',
                            100: '#FFCCBC',
                            200: '#FFAB91',
                            300: '#76ABAE',
                            400: '#76ABAE',
                            500: '#5B8C8F',
                            600: '#FF5722',
                            700: '#E64A19',
                            800: '#303841',
                            900: '#222831',
                        },
                        slate: {
                            50: '#F5F5F5',
                            100: '#ECECEC',
                            200: '#DFE5E7',
                            300: '#B8C4C6',
                            400: '#8A999B',
                            500: '#607274',
                            600: '#4A5560',
                            700: '#3A4750',
                            800: '#303841',
                            900: '#222831',
                            950: '#181C21',
                        },
                        teal: {
                            DEFAULT: '#76ABAE',
                            50: '#F1F7F7',
                            100: '#E2F0F0',
                            200: '#C5E1E2',
                            300: '#A3D0D2',
                            400: '#84BFC1',
                            500: '#76ABAE',
                            600: '#5B8C8F',
                            700: '#466C6E',
                            800: '#334D4E',
                            900: '#203031',
                        },
                        orange: {
                            DEFAULT: '#FF5722',
                            50: '#FBE9E7',
                            100: '#FFCCBC',
                            200: '#FFAB91',
                            300: '#FF8A65',
                            400: '#FF7043',
                            500: '#FF5722',
                            600: '#F4511E',
                            700: '#E64A19',
                            800: '#D84315',
                            900: '#BF360C',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="styles.css">
</head>
<body class="bg-[#F5F5F5] text-[#303841] min-h-screen flex flex-col antialiased">

    <!-- ==============================================================
         GLOBAL TOP NAVIGATION BAR
         ============================================================== -->
    <header class="sticky top-0 z-40 bg-white text-[#303841] border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="min-h-16 flex flex-wrap items-center justify-between gap-x-5 gap-y-2 py-2">
                <!-- Brand Logo -->
                <div class="flex items-center gap-3 cursor-pointer shrink-0" onclick="NavigationController.switchPortal('customer')">
                    <div class="w-10 h-10 rounded-xl bg-[#FF5722] flex items-center justify-center text-white shadow-sm">
                        <i data-lucide="printer" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <span class="font-extrabold text-lg text-[#303841] tracking-tight">QuickPrint<span class="text-[#FF5722]">Hub</span></span>
                        <p class="text-[11px] text-slate-500 hidden sm:block">Prints made easy</p>
                    </div>
                </div>

                <label class="hidden md:flex flex-1 max-w-sm items-center gap-2 px-4 py-2 rounded-md border border-slate-300 bg-white text-slate-400 focus-within:border-[#76ABAE]">
                    <input type="search" placeholder="Search printing services" class="w-full text-sm text-slate-700 outline-none placeholder:text-slate-400" aria-label="Search products and services">
                    <i data-lucide="search" class="w-4 h-4"></i>
                </label>

                <!-- Portal Switcher Navigation -->
                <nav class="flex items-center gap-1">
                    <button type="button" data-portal-btn="customer" onclick="NavigationController.switchPortal('customer')" class="px-2.5 py-1.5 text-xs font-bold rounded-lg bg-[#FF5722] text-white shadow-sm flex items-center gap-1.5 transition-all">
                        <i data-lucide="globe" class="w-4 h-4"></i><span>Shop</span>
                    </button>
                    <button type="button" data-portal-btn="staff" onclick="NavigationController.switchPortal('staff')" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100 flex items-center gap-1.5 transition-all">
                        <i data-lucide="user-check" class="w-4 h-4"></i><span class="hidden lg:inline">Staff</span>
                    </button>
                    <button type="button" data-portal-btn="admin" onclick="NavigationController.switchPortal('admin')" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100 flex items-center gap-1.5 transition-all">
                        <i data-lucide="shield" class="w-4 h-4"></i><span class="hidden lg:inline">Admin</span>
                    </button>
                    <button type="button" data-open-case-study class="px-2 py-1.5 text-xs font-semibold rounded-lg text-[#5B8C8F] bg-[#76ABAE]/10 hover:bg-[#76ABAE]/20 flex items-center gap-1" title="Academic Case Study Documentation">
                        <i data-lucide="book-open" class="w-3.5 h-3.5"></i><span class="hidden xl:inline">Case Study</span>
                    </button>
                </nav>

                <div id="auth-status-container" class="flex items-center gap-2">
                    <!-- Dynamically populated -->
                </div>
            </div>
            <nav class="hidden sm:flex items-center gap-8 border-t border-slate-100 py-3 text-sm text-slate-700" aria-label="Printing services">
                <a href="#personalized-catalog-section" onclick="filterOverviewProducts('all')" class="font-bold hover:text-[#FF5722]">All services</a>
                <a href="#personalized-catalog-section" onclick="filterOverviewProducts('documents')" class="hover:text-[#FF5722]">Documents &amp; thesis</a>
                <a href="#personalized-catalog-section" onclick="filterOverviewProducts('photo')" class="hover:text-[#FF5722]">Photo printing</a>
                <a href="#personalized-catalog-section" onclick="filterOverviewProducts('posters')" class="hover:text-[#FF5722]">Poster printing</a>
                <a href="#personalized-catalog-section" onclick="filterOverviewProducts('custom')" class="hover:text-[#FF5722]">Invitations &amp; custom printing</a>
                <a href="#order-placement-section" class="hover:text-[#FF5722]">Place an order</a>
            </nav>
        </div>
    </header>

    <!-- ==============================================================
         VIEW 1: CUSTOMER PORTAL
         ============================================================== -->
    <main id="portal-customer" class="flex-grow pb-16">
        <!-- Hero Section -->
        <section class="bg-[#F6EBDD] overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[430px] grid lg:grid-cols-2 items-center gap-4 lg:gap-8 py-12 lg:py-8">
                <div class="max-w-xl relative z-10">
                    <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[.16em] text-[#D94318] mb-4">
                        <i data-lucide="sparkles" class="w-4 h-4"></i> Your one-stop print shop
                    </span>
                    <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-semibold text-[#20252B] tracking-tight leading-[1.08]">
                        We take care of all your <span class="text-[#E9471B]">printing needs.</span>
                    </h1>
                    <p class="mt-5 text-base sm:text-lg text-slate-700 leading-relaxed max-w-lg">
                        Submit document, photo, poster, invitation, and custom-printing orders online, then track each order from pending to ready for pickup.
                    </p>
                    <div class="mt-7 flex flex-wrap gap-3">
                        <a href="#personalized-catalog-section" class="px-5 py-3 bg-[#F04418] hover:bg-[#D93A14] text-white font-semibold text-sm tracking-wide shadow-sm transition-colors">All services</a>
                        <a href="#order-placement-section" class="px-5 py-3 bg-slate-400 hover:bg-slate-500 text-white font-semibold text-sm tracking-wide transition-colors">Place an order</a>
                    </div>
                    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold text-slate-600">
                        <a href="#order-tracking-section" class="hover:text-[#E9471B]">Track an order →</a>
                    </div>
                </div>
                <figure class="w-full max-w-2xl justify-self-center lg:justify-self-end -mr-2 sm:-mr-8" aria-label="Examples of QuickPrint Hub document, photo, poster and custom printing">
                    <svg viewBox="0 0 640 430" role="img" aria-labelledby="hero-printing-title" class="w-full h-auto">
                        <title id="hero-printing-title">Examples of document, photo, poster and custom printing</title>
                        <defs>
                            <filter id="product-shadow" x="-30%" y="-30%" width="160%" height="180%"><feDropShadow dx="0" dy="12" stdDeviation="10" flood-color="#55483D" flood-opacity=".2" /></filter>
                            <linearGradient id="poster-sunset" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FFB21B"/><stop offset="1" stop-color="#F04A1D"/></linearGradient>
                            <linearGradient id="poster-blue" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#77D4D0"/><stop offset="1" stop-color="#246C89"/></linearGradient>
                        </defs>
                        <circle cx="490" cy="208" r="154" fill="#E8D6C1" opacity=".7"/>
                        <g filter="url(#product-shadow)" transform="rotate(-8 197 214)">
                            <rect x="73" y="92" width="168" height="245" rx="3" fill="#FFFDF8"/>
                            <rect x="83" y="102" width="148" height="225" fill="url(#poster-sunset)"/>
                            <circle cx="156" cy="166" r="43" fill="#FBE4A6" opacity=".9"/>
                            <path d="M88 237 Q148 174 226 235V320H88Z" fill="#172F43"/>
                            <path d="M104 259h105" stroke="#fff" stroke-width="4" opacity=".8"/>
                            <text x="157" y="217" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="17" font-weight="700">MAKE IT</text>
                            <text x="157" y="239" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="20" font-weight="900">BRIGHT</text>
                            <text x="157" y="303" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="9" letter-spacing="2">POSTER PRINT</text>
                        </g>
                        <g filter="url(#product-shadow)" transform="rotate(7 425 140)">
                            <rect x="344" y="42" width="175" height="213" rx="4" fill="#fff"/>
                            <rect x="354" y="52" width="155" height="193" fill="url(#poster-blue)"/>
                            <path d="M354 188 Q407 120 455 184T509 167V245H354Z" fill="#F9D343"/>
                            <path d="M354 208 Q408 146 459 208T509 191V245H354Z" fill="#EC5A46"/>
                            <text x="431" y="102" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="12" font-weight="700" letter-spacing="2">GOOD IDEAS</text>
                            <text x="431" y="127" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="22" font-weight="900">GET SEEN</text>
                            <circle cx="431" cy="157" r="13" fill="#FBE9E7"/>
                        </g>
                        <g filter="url(#product-shadow)" transform="rotate(9 529 307)">
                            <rect x="472" y="244" width="127" height="132" rx="7" fill="#fff"/>
                            <rect x="482" y="254" width="107" height="112" rx="3" fill="#EC4C91"/>
                            <path d="M482 340l37-50 24 30 18-19 28 31v34H482Z" fill="#FFCE44"/>
                            <text x="535" y="278" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="10" font-weight="700">CUSTOM</text>
                            <text x="535" y="293" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="13" font-weight="900">INVITES</text>
                        </g>
                        <g filter="url(#product-shadow)" transform="rotate(-5 321 338)">
                            <rect x="244" y="276" width="150" height="91" rx="5" fill="#fff"/>
                            <rect x="255" y="287" width="128" height="69" rx="3" fill="#303841"/>
                            <circle cx="278" cy="309" r="8" fill="#FF5722"/><circle cx="299" cy="309" r="8" fill="#76ABAE"/>
                            <path d="M271 329h94" stroke="#fff" stroke-width="4" opacity=".85"/>
                            <path d="M271 340h61" stroke="#C5E1E2" stroke-width="3"/>
                            <text x="321" y="302" text-anchor="middle" fill="#fff" font-family="Arial,sans-serif" font-size="9" font-weight="700" letter-spacing="1">DOCUMENT PRINTS</text>
                        </g>
                        <g fill="#F04418"><circle cx="288" cy="81" r="5"/><circle cx="567" cy="111" r="7"/><circle cx="414" cy="355" r="5"/></g>
                        <g fill="#76ABAE"><circle cx="89" cy="78" r="7"/><circle cx="432" cy="25" r="5"/></g>
                    </svg>
                </figure>
            </div>
        </section>

        <!-- TRACK MY ORDER SECTION -->
        <section id="order-tracking-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
                            <i data-lucide="search" class="w-6 h-6 text-blue-600"></i>
                            <span>Live Order & Queue Tracker</span>
                        </h2>
                        <p class="text-sm text-slate-500 mt-1">Enter your Queue Number (e.g. Q-101) or Tracking Code (e.g. QP-2026-101) to monitor printing progress.</p>
                    </div>
                    <!-- Sample quick chips -->
                    <div class="flex items-center gap-1.5 flex-wrap text-xs">
                        <span class="text-slate-400 font-medium">Try demos:</span>
                        <button type="button" onclick="CustomerController.trackOrder('Q-101')" class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono font-bold hover:bg-emerald-100">Q-101 (Ready)</button>
                        <button type="button" onclick="CustomerController.trackOrder('Q-102')" class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-200 font-mono font-bold hover:bg-blue-100">Q-102 (Printing)</button>
                        <button type="button" onclick="CustomerController.trackOrder('Q-103')" class="px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200 font-mono font-bold hover:bg-amber-100">Q-103 (Pending)</button>
                    </div>
                </div>

                <!-- Tracker Search Form -->
                <form id="tracker-search-form" class="flex flex-col sm:flex-row gap-3 max-w-2xl">
                    <div class="relative flex-1">
                        <i data-lucide="search" class="w-5 h-5 text-slate-400 absolute left-3.5 top-3"></i>
                        <input type="text" id="tracker-input-code" placeholder="Enter Queue Number (e.g. Q-101) or Tracking ID..." class="w-full pl-11 pr-4 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono uppercase" required>
                    </div>
                    <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl shadow-sm transition-all flex items-center justify-center gap-2">
                        <span>Check Status</span>
                    </button>
                </form>

                <!-- Tracker Not Found Alert -->
                <div id="tracker-not-found" class="hidden mt-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm flex items-center gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-red-600 flex-shrink-0"></i>
                    <div>
                        <span class="font-bold">Order not found:</span> No active or past orders match "<span id="tracker-not-found-query" class="font-mono"></span>". Please double-check your claim ticket.
                    </div>
                </div>

                <!-- Tracker Results Display Card -->
                <div id="tracker-results-card" class="hidden mt-8 p-6 bg-slate-50 rounded-2xl border border-slate-200">
                    <div id="tracker-active-code" data-code=""></div>
                    
                    <!-- Top Status Banner -->
                    <div id="track-disp-position-banner" class="mb-6">
                        <!-- Populated dynamically -->
                    </div>

                    <!-- 4-Step Stepper -->
                    <div class="mb-8 px-2 sm:px-6">
                        <div class="flex items-center justify-between relative">
                            <!-- Step 1: Pending -->
                            <div class="flex flex-col items-center z-10">
                                <div id="step-circle-pending" class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">1</div>
                                <span id="step-label-pending" class="text-xs font-bold text-blue-700 mt-2">Pending</span>
                            </div>
                            <div id="step-line-pending" class="h-1 bg-blue-600 flex-1 mx-2"></div>

                            <!-- Step 2: Processing -->
                            <div class="flex flex-col items-center z-10">
                                <div id="step-circle-processing" class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-semibold text-sm flex items-center justify-center">2</div>
                                <span id="step-label-processing" class="text-xs text-slate-400 mt-2">Processing</span>
                            </div>
                            <div id="step-line-processing" class="h-1 bg-slate-200 flex-1 mx-2"></div>

                            <!-- Step 3: Ready -->
                            <div class="flex flex-col items-center z-10">
                                <div id="step-circle-ready" class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-semibold text-sm flex items-center justify-center">3</div>
                                <span id="step-label-ready" class="text-xs text-slate-400 mt-2">Ready for Pickup</span>
                            </div>
                            <div id="step-line-ready" class="h-1 bg-slate-200 flex-1 mx-2"></div>

                            <!-- Step 4: Completed -->
                            <div class="flex flex-col items-center z-10">
                                <div id="step-circle-completed" class="w-8 h-8 rounded-full bg-slate-200 text-slate-500 font-semibold text-sm flex items-center justify-center">4</div>
                                <span id="step-label-completed" class="text-xs text-slate-400 mt-2">Completed</span>
                            </div>
                        </div>
                    </div>

                    <!-- Order Details Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs sm:text-sm bg-white p-5 rounded-xl border border-slate-200">
                        <div>
                            <span class="text-slate-400 block text-[11px]">QUEUE NUMBER</span>
                            <span id="track-disp-queue" class="text-2xl font-black font-mono text-blue-700">Q-101</span>
                            <span id="track-disp-tracking" class="text-slate-500 block text-[11px] font-mono mt-0.5">QP-2026-101</span>
                        </div>
                        <div>
                            <span class="text-slate-400 block text-[11px]">CUSTOMER NAME</span>
                            <span id="track-disp-name" class="font-bold text-slate-800 text-base">Juan Dela Cruz</span>
                            <span id="track-disp-service" class="text-slate-600 block text-xs mt-0.5">Document Printing</span>
                        </div>
                        <div>
                            <span class="text-slate-400 block text-[11px]">PRINTING SPECIFICATIONS</span>
                            <span id="track-disp-station" class="font-semibold text-slate-800">Document printing</span>
                            <span id="track-disp-specs" class="text-slate-500 block text-xs mt-0.5">30 pages • A4 size</span>
                        </div>
                        <div>
                            <span class="text-slate-400 block text-[11px]">PAYMENT & BALANCE</span>
                            <div class="flex items-center gap-2">
                                <span id="track-disp-total" class="font-bold text-slate-900 text-base">₱60.00</span>
                                <span id="track-disp-pay-status" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">PAID</span>
                            </div>
                            <span class="text-slate-500 block text-xs mt-0.5">Remaining Balance: <b id="track-disp-balance" class="text-red-600 font-mono">₱0.00</b></span>
                        </div>
                    </div>

                    <!-- Action footer -->
                    <div class="mt-4 flex items-center justify-between pt-3 border-t border-slate-200 text-xs">
                        <span class="text-slate-500">Pick-up Location: <b>Ground Floor, Student Plaza Commercial Complex</b></span>
                        <button type="button" id="track-print-slip-btn" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-lg shadow-sm flex items-center gap-1.5">
                            <i data-lucide="printer" class="w-3.5 h-3.5"></i> Print Claim Slip
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ORDER PLACEMENT & PRICE ESTIMATOR SECTION -->
        <section id="order-placement-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                
                <!-- Left 7 Cols: Order Submission Form -->
                <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
                    <div class="mb-6">
                        <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
                            <i data-lucide="file-plus" class="w-6 h-6 text-blue-600"></i>
                            <span>Online Printing Order Submission</span>
                        </h2>
                        <p class="text-sm text-slate-500 mt-1">Configure your printing specifications below. You will be issued a Queue Claim Number immediately.</p>
                    </div>

                    <form id="customer-order-form" class="space-y-5">
                        <!-- Customer Info Row -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Full Name *</label>
                                <input type="text" id="cust-name" placeholder="e.g. Maria Santos" class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:outline-none" required>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Mobile Contact No. *</label>
                                <input type="text" id="cust-contact" placeholder="e.g. 0917-123-4567" class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:outline-none" required>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email (Optional)</label>
                            <input type="email" id="cust-email" placeholder="For order updates" class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        </div>

                        <!-- Service Selection -->
