    <div id="admin-add-service-modal" class="hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl">
            <h3 class="font-bold text-slate-900 text-base mb-1">Add Printing Service</h3>
            <p class="text-xs text-slate-500 mb-4">Register a new offering in the service catalog.</p>
            <form id="admin-add-service-form" class="space-y-3 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Service Name *</label>
                    <input type="text" id="new-srv-name" placeholder="e.g. Blueprints & CAD Printing" class="w-full px-3 py-1.5 rounded border border-slate-300" required>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Category</label>
                        <input type="text" id="new-srv-category" placeholder="Architectural" class="w-full px-3 py-1.5 rounded border border-slate-300">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Base Price (₱) *</label>
                        <input type="number" id="new-srv-price" step="0.50" min="0" placeholder="50.00" class="w-full px-3 py-1.5 rounded border border-slate-300 font-mono" required>
                    </div>
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Unit Description</label>
                    <input type="text" id="new-srv-unit" placeholder="per sheet / per unit" class="w-full px-3 py-1.5 rounded border border-slate-300">
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Description</label>
                    <textarea id="new-srv-desc" rows="2" placeholder="Details about this printing service..." class="w-full px-3 py-1.5 rounded border border-slate-300"></textarea>
                </div>
                <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
                    <button type="button" onclick="document.getElementById('admin-add-service-modal').classList.add('hidden')" class="px-3 py-1.5 text-slate-600 hover:bg-slate-100 rounded">Cancel</button>
                    <button type="submit" class="px-4 py-1.5 font-bold bg-indigo-700 hover:bg-indigo-800 text-white rounded">Add Service</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 7. CASE STUDY & ACADEMIC DOCUMENTATION MODAL -->
    <div id="case-study-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6">
        <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[92vh] flex flex-col shadow-2xl overflow-hidden">
            <!-- Modal Header -->
            <div class="p-6 bg-slate-900 text-white flex items-start justify-between">
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-blue-400">ICCT Colleges • College of Computer Studies</span>
                    <h2 id="cs-doc-title" class="text-xl sm:text-2xl font-black mt-1 leading-snug">QuickPrint Hub: A Web-Based Printing Shop Queue and Order Management System</h2>
                    <p class="text-xs text-slate-400 mt-1">
                        ICCT Colleges • College of Computer Studies
                    </p>
                </div>
                <button type="button" id="case-study-close-btn" class="text-slate-400 hover:text-white p-1">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <!-- Document Navigation Tabs -->
            <div class="flex items-center gap-1 px-6 pt-3 border-b border-slate-200 bg-white overflow-x-auto">
                <button type="button" data-doc-tab="abstract" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-blue-600 text-white shadow-sm">Abstract</button>
                <button type="button" data-doc-tab="background" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100">1.1 Background</button>
                <button type="button" data-doc-tab="problem" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100">1.2 Statement of Problem</button>
                <button type="button" data-doc-tab="objectives" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100">1.3 Objectives (SO1-SO5)</button>
                <button type="button" data-doc-tab="scope" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100">1.4 Scope & Delimitations</button>
                <button type="button" data-doc-tab="flowchart" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100">System Flowcharts</button>
            </div>

            <!-- Document Content Scroll Area -->
            <div id="cs-doc-content-area" class="p-6 overflow-y-auto flex-grow">
                <!-- Populated dynamically by case-study.js -->
            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-between items-center text-xs text-slate-500">
                <span>ICCT Colleges • College of Computer Studies</span>
                <button type="button" onclick="CaseStudyController.closeModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-lg">
                    Close Document
                </button>
            </div>
        </div>
    </div>

    <!-- 8. HIDDEN PRINT AREA FOR RECEIPT / REPORTS -->
    <div id="print-section" class="hidden"></div>

    <!-- ==============================================================
         JAVASCRIPT CONTROLLERS
         ============================================================== -->
    <script src="js/store.js"></script>
    <script src="js/customer.js"></script>
    <script src="js/staff.js"></script>
    <script src="js/admin.js"></script>
    <script src="js/case-study.js"></script>

    <!-- Navigation & App Coordinator -->
    <script>
        const NavigationController = {
            currentPortal: 'customer',

            init() {
                this.renderAuthBar();
                this.switchPortal('customer');

                window.addEventListener('quickprint_state_updated', () => {
                    this.renderAuthBar();
                });
            },

            switchPortal(portalName) {
                this.currentPortal = portalName;
                const portals = ['customer', 'staff', 'admin'];

                portals.forEach(p => {
                    const el = document.getElementById(`portal-${p}`);
                    const btn = document.querySelector(`[data-portal-btn="${p}"]`);
                    if (el) {
                        if (p === portalName) {
                            el.classList.remove('hidden');
                        } else {
                            el.classList.add('hidden');
                        }
                    }
                    if (btn) {
                        if (p === portalName) {
                            btn.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg bg-[#FF5722] text-white shadow-sm flex items-center gap-1.5 transition-all';
                        } else {
                            btn.className = 'px-2.5 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100 flex items-center gap-1.5 transition-all';
                        }
                    }
                });

                // Auto-prompt login if accessing staff or admin without session
                if ((portalName === 'staff' || portalName === 'admin')) {
                    const user = window.QuickPrintStore.getCurrentUser();
                    if (!user) {
                        this.promptLogin(portalName);
                    }
                }
            },

            promptLogin(preferredRole) {
                const username = prompt(`Please log in to access the ${preferredRole.toUpperCase()} console.\n(Demo accounts: "staff" / "staff123" or "admin" / "admin123")\n\nEnter Username:`, preferredRole === 'admin' ? 'admin' : 'staff');
                if (!username) return;

                const password = prompt(`Enter Password for ${username}:`, username === 'admin' ? 'admin123' : 'staff123');
                if (!password) return;

                const res = window.QuickPrintStore.login(username, password);
                if (res.success) {
                    alert(`Welcome, ${res.user.fullName}!`);
                    this.renderAuthBar();
                } else {
                    alert(res.message);
                }
            },

            renderAuthBar() {
                const container = document.getElementById('auth-status-container');
                if (!container) return;

                const user = window.QuickPrintStore.getCurrentUser();
                if (user) {
                    container.innerHTML = `
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-semibold text-slate-700 hidden sm:inline">
                                ${user.fullName.split(' ')[0]} <span class="text-[10px] px-1.5 py-0.5 rounded font-bold bg-[#76ABAE]/15 text-[#466C6E] border border-[#76ABAE]/40">${user.role}</span>
                            </span>
                            <button type="button" onclick="QuickPrintStore.logout()" class="px-2.5 py-1 text-xs font-semibold rounded border border-slate-300 hover:bg-slate-100 text-slate-700">
                                Logout
                            </button>
                        </div>
                    `;
                } else {
                    container.innerHTML = `
                        <button type="button" onclick="NavigationController.promptLogin('staff')" class="px-3 py-1.5 text-xs font-bold rounded-lg border border-[#76ABAE] text-[#466C6E] hover:bg-[#76ABAE]/15 transition-all">
                            Log in
                        </button>
                    `;
                }
            }
        };

        // Initialize All Modules on DOM load
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            NavigationController.init();
            CustomerController.init();
            StaffController.init();
            AdminController.init();
            CaseStudyController.init();
            // Default open abstract in case study modal
            CaseStudyController.showDocSection('abstract');
        });
    </script>
</body>
</html>
